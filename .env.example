# Copy to .env for local use. In Claude Code on the web, set these as
# environment variables on the environment instead (never commit .env).

# System User token from Meta Business Settings (never expires).
# Leave EMPTY and set META_TOKEN_VIA_PROXY=1 if the token is stored as an
# "API credential" on the Claude Code cloud environment (preferred: Claude
# never sees the token).
META_ACCESS_TOKEN=
META_TOKEN_VIA_PROXY=

# Ad account(s) the tool may write to. Comma-separated, each "act_<number>".
# The first one is the default.
META_AD_ACCOUNT_ID=act_1234567890

# Facebook Page the ads run under.
META_PAGE_ID=

# Optional: Instagram account id to run ads under (leave blank to skip).
META_INSTAGRAM_ACTOR_ID=

# Optional: Pixel/dataset id for conversion objectives.
META_PIXEL_ID=

# Marketing API version.
META_API_VERSION=v23.0

# Budget changes larger than this fraction (either direction) need approval.
META_BUDGET_CHANGE_APPROVAL_PCT=10

# Optional hard ceiling on any single daily budget, in whole currency units.
# Refused even with approval. Leave blank for no ceiling.
META_MAX_DAILY_BUDGET=
